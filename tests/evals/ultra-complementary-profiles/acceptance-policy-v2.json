    "architecture_attribution": {
      "required": true,
      "treatment_must_pass": true,
      "ablation_final_state_must_be_valid": true,
      "repository_artifact_validation_tracker_and_write_set_must_pass": true,
      "required_difference": "extra_exploration_call",
      "allowed_ablation_failure_codes": [
        "duplicate_evidence_goal",
        "extra_exploration_call"
      ],
      "no_other_failures": true
    }
  },
  "attempt_policy": {
    "state_receipts": "append-only-lock-protected-jsonl",
    "runtime_invoked": "record-before-runtime-cli-execution",
    "model_started": "true-only-when-raw-runtime-trace-has-an-assistant-model-event",
    "model_started_attempts_per_cell": 1,
    "retry_after_model_start": false,
    "retry_after_runtime_invoked_without_model_event": false,
    "pre_model_infrastructure_retry": {
      "allowed": true,
      "requires_new_attempt_id": true,
      "preserve_failed_attempt": true,
      "requires_runtime_invoked_false": true
    }
  },
  "evidence": {
    "canonical_manifest": {
      "schema_version": 2,
      "path": "canonical-manifest.json",
      "create": "atomic-create-only",
      "overwrite": "forbidden",
      "required_fields": [
        "schema_version",
        "policy.id",
        "policy.commit_sha",
        "policy.file_sha256",
        "runtime",
        "refs.treatment",
        "refs.ablation",
        "run_ids",
        "timeout_seconds",
        "execution_order",
        "cells.run_id",
        "cells.model",
        "cells.reasoning_effort",
        "cells.context_window",
        "cells.scenario",
        "cells.variants"
      ]
    },
    "grade_from": [
      "final_repository_state",
      "artifact_state",
      "validation_state",
      "tracker_or_publication_state",
      "write_set",
      "raw_delegation_trace"
    ],
    "durable_verdicts": ["cell_state", "pair_verdict", "phase_verdict"],
    "historical_attempts_may_satisfy_gate": false,
    "v1_evidence": "permanently-non-gating"
